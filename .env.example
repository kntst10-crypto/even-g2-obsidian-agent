# Generate token with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=
VAULT_ROOT=./demo-vault
PORT=8788
# Loopback only. Configure a private HTTPS reverse proxy for remote access.
PUBLIC_ORIGIN=http://127.0.0.1:8788
# Optional exact additional Even Hub webview origin; never '*'.
CLIENT_ORIGIN=
# Cloud remains OFF unless explicitly enabled. Browser also asks per request.
ALLOW_CLOUD=false
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DAILY_FOLDER=Daily
TIME_ZONE=Asia/Tokyo
